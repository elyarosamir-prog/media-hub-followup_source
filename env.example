# Copy these into Vercel -> Project Settings -> Environment Variables.
DATABASE_URL=mysql://USER:PASSWORD@HOST:4000/DB?ssl={"rejectUnauthorized":true}
JWT_SECRET=change-me-to-a-long-random-string-32+chars
ADMIN_EMAIL=you@example.com
# Generate with: node scripts/hash-password.mjs "your-password"
ADMIN_PASSWORD_HASH=scrypt$...$...
ADMIN_NAME=مسؤول النظام
